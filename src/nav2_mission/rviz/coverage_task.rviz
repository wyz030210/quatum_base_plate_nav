Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 30
      Color: 160; 160; 164
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Vehicle
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: Intensity
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.25
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.25
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Polygon
      Name: Robot Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color: 255; 255; 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Coverage Region
      Enabled: true
      Topic:
        Value: /coverage/region_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Polygon
      Name: OpenNav Field Boundary
      Enabled: true
      Topic:
        Value: /coverage_server/field_boundary
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color: 0; 180; 255
    - Class: rviz_default_plugins/Polygon
      Name: OpenNav Planning Field
      Enabled: true
      Topic:
        Value: /coverage_server/planning_field
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color: 100; 100; 255
    - Class: rviz_default_plugins/Marker
      Name: OpenNav Swaths
      Enabled: true
      Topic:
        Value: /coverage_server/swaths
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Path
      Name: OpenNav Coverage Plan
      Enabled: true
      Topic:
        Value: /coverage_server/coverage_plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Line Style: Lines
      Line Width: 0.03
      Color: 0; 255; 255
    - Class: rviz_default_plugins/Path
      Name: Accepted Coverage Path
      Enabled: true
      Topic:
        Value: /coverage/planned_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.04
      Color: 0; 255; 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Executed Coverage Trace
      Enabled: true
      Topic:
        Value: /coverage/executed_trace
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Line Style: Lines
      Line Width: 0.03
      Color: 255; 0; 255
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 30
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
